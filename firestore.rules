rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner() { return signedIn() && exists(/databases/$(database)/documents/system/adminOwner) && get(/databases/$(database)/documents/system/adminOwner).data.uid == request.auth.uid; }
  function admin() { return signedIn() && (request.auth.token.admin == true || owner()); }
  function staffPermission(permission) { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('active',false) == true && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('permissions',[]).hasAny([permission]); }
  function can(permission) { return admin() || staffPermission(permission); }
  match /system/categoryDefaultsInitialized {
   allow get: if admin();
   allow list: if false;
   allow create: if admin() && !exists(/databases/$(database)/documents/system/categoryDefaultsInitialized);
   allow update, delete: if false;
  }
  match /staff/{id} {
   allow get: if admin() || (signedIn() && request.auth.uid == id);
   allow list: if admin();
   allow create, update, delete: if admin();
  }
  match /system/adminOwner {
   allow get: if signedIn() && (request.auth.token.email == 'sufiyankadival2@gmail.com' || admin());
   allow list: if false;
   allow create: if signedIn() && request.auth.token.email == 'sufiyankadival2@gmail.com' && !exists(/databases/$(database)/documents/system/adminOwner) && request.resource.data.keys().hasOnly(['uid','email','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email;
   allow update, delete: if false;
  }
  function verified() { return signedIn(); }
  function trialActive() { return verified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('trialExpiresAt', timestamp.date(1970,1,1)) > request.time; }
  function publicAvailableCourse(courseId) {
   return exists(/databases/$(database)/documents/courses/$(courseId)) && get(/databases/$(database)/documents/courses/$(courseId)).data.get('published', false) == true && get(/databases/$(database)/documents/courses/$(courseId)).data.get('status', 'available') != 'comingSoon';
  }
  function trialLessonAccess(courseId, lectureId) {
   return trialActive() && publicAvailableCourse(courseId) && exists(/databases/$(database)/documents/courses/$(courseId)/lectures/$(lectureId)) && get(/databases/$(database)/documents/courses/$(courseId)/lectures/$(lectureId)).data.get('trialEnabled',false) == true;
  }
  function enrolled(courseId) { return verified() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)); }
  function bundleAccess(courseId) { return verified() && exists(/databases/$(database)/documents/courses/$(courseId)) && get(/databases/$(database)/documents/courses/$(courseId)).data.get('includedInCourseIds', []).size() > 0 && enrolled(get(/databases/$(database)/documents/courses/$(courseId)).data.get('includedInCourseIds', [])[0]); }
  function courseAccess(courseId) { return enrolled(courseId) || bundleAccess(courseId); }
  // Public metadata for an unpublished folder belonging to a published bundle.
  // The private /lectures documents remain enrollment- or trial-protected.
  function publicBundleFolder(courseId) {
   return exists(/databases/$(database)/documents/courses/$(courseId))
    && get(/databases/$(database)/documents/courses/$(courseId)).data.get('folderOnly', false) == true
    && get(/databases/$(database)/documents/courses/$(courseId)).data.get('includedInCourseIds', []).size() > 0
    && exists(/databases/$(database)/documents/courses/$(get(/databases/$(database)/documents/courses/$(courseId)).data.get('includedInCourseIds', [])[0]))
    && get(/databases/$(database)/documents/courses/$(get(/databases/$(database)/documents/courses/$(courseId)).data.get('includedInCourseIds', [])[0])).data.get('published', false) == true
    && get(/databases/$(database)/documents/courses/$(get(/databases/$(database)/documents/courses/$(courseId)).data.get('includedInCourseIds', [])[0])).data.get('includedCourseIds', []).hasAny([courseId]);
  }
  match /users/{id} {
   allow read: if signedIn() && (request.auth.uid == id || can("users.view"));
   allow create: if signedIn() && request.auth.uid == id && request.resource.data.keys().hasOnly(['name','email','phone','createdAt']) && request.resource.data.email == request.auth.token.email;
   allow update: if can("users.edit") || (signedIn() && request.auth.uid == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','city','bio','photoURL']));
   allow delete: if can("users.delete");
  }
  match /courses/{id} {
   allow read: if resource.data.published == true || publicBundleFolder(id) || can("courses.view") || courseAccess(id);
   allow create: if can("courses.create");
   allow update: if can("courses.edit");
   allow delete: if can("courses.delete");
   match /sections/{sectionId} {
    allow read: if can("lectures.manage") || courseAccess(id);
    allow create, update: if can("lectures.manage");
    allow delete: if can("lectures.delete");
   }
   match /lectureCatalog/{lectureId} {
    allow read: if publicAvailableCourse(id) || publicBundleFolder(id) || courseAccess(id) || can("lectures.manage");
    allow create, update: if can("lectures.manage");
    allow delete: if can("lectures.delete");
   }
   match /lectures/{lectureId} {
    allow read: if can("lectures.manage") || (verified() && (courseAccess(id) || (publicAvailableCourse(id) && ((get(/databases/$(database)/documents/courses/$(id)).data.get('price', 0) == 0 && resource.data.get('freePreview',false) == true) || (trialActive() && resource.data.get('trialEnabled',false) == true)))));
    allow create, update: if can("lectures.manage");
    allow delete: if can("lectures.delete");
   }
  }
  match /lessonProgress/{id} {
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || can("enrollments.view"));
   allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.courseId is string && request.resource.data.lectureId is string && id == request.auth.uid + "_" + request.resource.data.courseId + "_" + request.resource.data.lectureId && request.resource.data.completed == true && request.resource.data.watchedSeconds is number && request.resource.data.duration is number && (
     (request.resource.data.get('manuallyCompleted',false) == true && request.resource.data.watchedSeconds == 0 && request.resource.data.duration == 0) ||
     (request.resource.data.get('manuallyCompleted',false) == false && request.resource.data.duration > 0 && request.resource.data.watchedSeconds >= request.resource.data.duration * 0.9)
   ) && (courseAccess(request.resource.data.courseId) || trialLessonAccess(request.resource.data.courseId,request.resource.data.lectureId));
   allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.courseId == resource.data.courseId && request.resource.data.lectureId == resource.data.lectureId && request.resource.data.completed == true && request.resource.data.watchedSeconds is number && request.resource.data.duration is number && (
     (request.resource.data.get('manuallyCompleted',false) == true && request.resource.data.watchedSeconds == 0 && request.resource.data.duration == 0) ||
     (request.resource.data.get('manuallyCompleted',false) == false && request.resource.data.duration > 0 && request.resource.data.watchedSeconds >= request.resource.data.duration * 0.9)
   ) && (courseAccess(resource.data.courseId) || trialLessonAccess(resource.data.courseId,resource.data.lectureId));
   allow delete: if false;
  }
  match /tracks/{id} { allow read: if true; allow create: if can("categories.create"); allow update: if can("categories.edit"); allow delete: if can("categories.delete"); }
  match /enrollments/{id} { allow read: if can("enrollments.view") || (signedIn() && resource.data.userId == request.auth.uid); allow create: if can("enrollments.grant") && request.resource.data.userId is string && request.resource.data.courseId is string && id == request.resource.data.userId + "_" + request.resource.data.courseId; allow update: if can("enrollments.grant") && request.resource.data.userId == resource.data.userId && request.resource.data.courseId == resource.data.courseId; allow delete: if can("enrollments.revoke"); }
  match /{document=**} { allow read, write: if false; }
 }
}
