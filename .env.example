# Public Vite build-time variable. Cloudflare Turnstile site key (NOT a secret).
VITE_TURNSTILE_SITE_KEY=
# All SECRET values must be configured in Cloudflare Pages environment settings:
# OTP_HASH_SECRET (random, 32+ chars)
# TURNSTILE_SECRET
# RESEND_API_KEY
# EMAIL_FROM (verified sender domain)
# RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET
# PAYMENTS_ENABLED=false until fully tested
# DB: D1 database binding (not an environment string)
# VIDEOS: private R2 bucket binding (not an environment string)
