{
  "name": "edutech-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --test && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "pages:dev": "wrangler pages dev dist",
    "d1:migrate:local": "wrangler d1 migrations apply edutech-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply edutech-db --remote"
  },
  "dependencies": {
    "framer-motion": "^12.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "react-hot-toast": "^2.5.2",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0",
    "wrangler": "^4.45.0"
  }
}
